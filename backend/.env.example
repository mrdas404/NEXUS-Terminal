PORT=3001
# Comma-separated exact browser origins; CORS is not authentication.
CORS_ORIGINS=http://localhost:5173
# Use separate files for core terminal state and research/paper trading data.
CORE_DB_PATH=./prisma/core.sqlite
RESEARCH_DB_PATH=./prisma/research.sqlite
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
