PORT=3001
# Comma-separated browser origins allowed to call the backend. Avoid * in production.
CORS_ORIGINS=http://localhost:5173
# Keep database files on a persistent writable volume in production.
CORE_DB_PATH=./prisma/dev.db
RESEARCH_DB_PATH=./prisma/dev.db
# Frontend build-time values (configure in frontend environment separately):
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001
