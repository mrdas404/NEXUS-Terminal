PORT=3001
# Exact browser origins; CORS is not authentication.
CORS_ORIGINS=http://localhost:5173
# Required: one admin password (16+ characters) and a random session signing secret (32+ characters).
# Generate SESSION_SECRET with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=
# Use separate files for core terminal state and research/paper trading data.
CORE_DB_PATH=./prisma/core.sqlite
RESEARCH_DB_PATH=./prisma/research.sqlite
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
