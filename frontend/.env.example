# Set this in Vercel Project Settings -> Environment Variables.
# Prefer a custom API hostname on the same site as the frontend (e.g. api.example.com).
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Optional override. If omitted, the frontend derives wss://<VITE_API_URL host>/ws.
# VITE_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com/ws
